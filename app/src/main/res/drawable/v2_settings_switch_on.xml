<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="78dp" android:height="40dp" />
            <corners android:radius="3dp" />
            <solid android:color="@color/settings_switch_on" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="6dp">
        <shape android:shape="rectangle">
            <size android:width="18dp" android:height="30dp" />
            <corners android:radius="3dp" />
            <solid android:color="@color/settings_switch_thumb" />
        </shape>
    </item>
</layer-list>
