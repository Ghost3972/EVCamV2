<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="240dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frame_front"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/home_preview_background">

                <com.kooo.evcam.v2.ui.V2AutoFitTextureView
                    android:id="@+id/texture_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/preview_placeholder_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/home_placeholder_background"
                    android:gravity="center"
                    android:text="预览已停止"
                    android:textColor="@color/home_placeholder_text"
                    android:textSize="26sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fps_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/camera_label_background"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="--×--"
                    android:textColor="@color/playback_video_text"
                    android:textSize="12sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frame_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/home_preview_background">

                <com.kooo.evcam.v2.ui.V2AutoFitTextureView
                    android:id="@+id/texture_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/preview_placeholder_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/home_placeholder_background"
                    android:gravity="center"
                    android:text="预览已停止"
                    android:textColor="@color/home_placeholder_text"
                    android:textSize="26sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fps_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/camera_label_background"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="--×--"
                    android:textColor="@color/playback_video_text"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frame_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/home_preview_background">

                <com.kooo.evcam.v2.ui.V2AutoFitTextureView
                    android:id="@+id/texture_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/preview_placeholder_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/home_placeholder_background"
                    android:gravity="center"
                    android:text="预览已停止"
                    android:textColor="@color/home_placeholder_text"
                    android:textSize="26sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fps_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/camera_label_background"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="--×--"
                    android:textColor="@color/playback_video_text"
                    android:textSize="12sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frame_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/home_preview_background">

                <com.kooo.evcam.v2.ui.V2AutoFitTextureView
                    android:id="@+id/texture_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/preview_placeholder_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/home_placeholder_background"
                    android:gravity="center"
                    android:text="预览已停止"
                    android:textColor="@color/home_placeholder_text"
                    android:textSize="26sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fps_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/camera_label_background"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="--×--"
                    android:textColor="@color/playback_video_text"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@color/home_side_panel_background"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/v2_home_dvr_back"
            android:contentDescription="视频回看"
            android:scaleType="fitCenter" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <CheckedTextView
                android:id="@+id/btn_start_record"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/v2_home_selector_recording"
                android:clickable="true"
                android:contentDescription="开始录制"
                android:focusable="true"
                android:gravity="center" />

            <ImageView
                android:id="@+id/normal_recording_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/v2_home_normal_recording_checked"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="循环录制"
            android:textColor="@color/home_text_primary"
            android:textSize="28sp" />

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="100dp">

            <CheckedTextView
                android:id="@+id/btn_video_playback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/v2_home_selector_event_recording"
                android:clickable="true"
                android:contentDescription="紧急录制"
                android:focusable="true"
                android:gravity="center" />

            <com.kooo.evcam.v2.ui.V2CircularProgressView
                android:id="@+id/emergency_recording_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="紧急录制"
            android:textColor="@color/home_text_primary"
            android:textSize="28sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/v2_home_dvr_close"
            android:contentDescription="关闭"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="290dp"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_datetime"
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="----年--月--日 --:--:--"
            android:textColor="@color/home_overlay_text"
            android:textSize="38sp" />

        <LinearLayout
            android:id="@+id/tv_recording_pill"
            android:layout_width="wrap_content"
            android:layout_height="62dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/v2_home_status_pill_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <View
                android:id="@+id/recording_dot"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="@drawable/v2_home_recording_dot" />

            <TextView
                android:id="@+id/tv_recording_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:text="录制中"
                android:textColor="@color/playback_video_text"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_recording_stats"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</FrameLayout>
