<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/playback_background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="536dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/tab_normal_video"
            android:layout_width="536dp"
            android:layout_height="128dp"
            android:layout_marginTop="52dp"
            android:background="@drawable/v2_playback_tab_checked_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent"
                android:background="@color/playback_accent" />

            <ImageView
                android:id="@+id/tab_normal_video_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="60dp"
                android:contentDescription="循环录像"
                android:src="@drawable/v2_playback_ic_normal_video_checked" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="循环录像"
                android:textColor="@color/playback_accent"
                android:textSize="38sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_event_video"
            android:layout_width="536dp"
            android:layout_height="128dp"
            android:layout_marginTop="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tab_event_video_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="70dp"
                android:contentDescription="紧急录像"
                android:src="@drawable/v2_playback_ic_event_video" />

            <TextView
                android:id="@+id/tab_event_video_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="紧急录像"
                android:textColor="@color/text_secondary"
                android:textSize="38sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_photo"
            android:layout_width="536dp"
            android:layout_height="128dp"
            android:layout_marginTop="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tab_photo_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="70dp"
                android:contentDescription="图片"
                android:src="@drawable/v2_playback_ic_photo" />

            <TextView
                android:id="@+id/tab_photo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="图片"
                android:textColor="@color/text_secondary"
                android:textSize="38sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_home"
            android:layout_width="452dp"
            android:layout_height="120dp"
            android:layout_marginStart="60dp"
            android:layout_marginBottom="60dp"
            android:background="@drawable/v2_playback_live_button_bg"
            android:contentDescription="实时画面"
            android:drawableStart="@drawable/v2_playback_ic_camera"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="实时画面"
            android:textColor="@color/playback_on_accent"
            android:textSize="34sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_refresh"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/v2_playback_ic_select_date"
        android:contentDescription="选择日期"
        app:layout_constraintEnd_toStartOf="@id/btn_setting"
        app:layout_constraintTop_toTopOf="@id/btn_setting" />

    <ImageButton
        android:id="@+id/btn_setting"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="110dp"
        android:background="@drawable/v2_playback_ic_setting"
        android:contentDescription="设置"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/content_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/toolbar"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="120dp"
            android:paddingTop="160dp"
            android:paddingEnd="116dp">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/video_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="暂无录制文件"
                android:textColor="@color/text_secondary"
                android:textSize="32sp"
                android:visibility="gone" />
        </FrameLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/playback_background"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_title_bar"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@color/playback_background"
            android:elevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_player_back"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="80dp"
                android:background="@drawable/v2_home_dvr_back"
                android:contentDescription="返回"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="42dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_player_back"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/player_title_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="----年--月--日"
                    android:textColor="@color/text_primary"
                    android:textSize="54sp" />

                <TextView
                    android:id="@+id/player_title_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="7dp"
                    android:fontFamily="sans-serif"
                    android:text="--:--:--"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_player_delete"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="80dp"
                android:background="@drawable/v2_player_ic_delete"
                android:contentDescription="删除"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_player_move"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="80dp"
                android:background="@drawable/v2_player_ic_move"
                android:contentDescription="移动"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_player_delete"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/grid_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#000000"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.kooo.evcam.v2.ui.playback.V2StretchVideoView
                android:id="@+id/video_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true" />

            <ImageView
                android:id="@+id/photo_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:clickable="true"
                android:contentDescription="图片预览"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/placeholder_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="视频文件加载失败"
                android:textColor="@color/playback_video_text"
                android:textSize="34sp"
                android:clickable="true"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_snapshot"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="80dp"
            android:background="@drawable/v2_player_ic_snapshot"
            android:contentDescription="截图"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/current_datetime"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/controls_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/v2_player_bottom_bg"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="80dp"
            android:paddingTop="40dp"
            android:paddingEnd="80dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current_time"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="00:00"
                    android:textColor="@color/playback_video_text"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="56dp"
                    android:layout_marginEnd="56dp"
                    android:max="100"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:progressDrawable="@drawable/v2_player_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/v2_player_seekbar_thumb"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:gravity="end|center_vertical"
                    android:text="00:00"
                    android:textColor="@color/playback_video_text"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@null"
                    android:contentDescription="播放"
                    android:scaleType="fitCenter"
                    android:src="@drawable/v2_player_ic_play" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_speed"
                    android:layout_width="112dp"
                    android:layout_height="72dp"
                    android:background="@drawable/v2_player_speed_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="1.0X"
                    android:textColor="@color/playback_video_text"
                    android:textSize="28sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
