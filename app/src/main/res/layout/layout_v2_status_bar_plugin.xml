<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/v2_status_bar_plugin_bg"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_status_bar_recording"
        android:layout_width="match_parent"
        android:layout_height="@dimen/v2_status_bar_dvr_h"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_status_bar_recording_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="行车记录仪"
            android:textColor="#E5000000"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/v2_status_bar_title_text"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status_bar_recording_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未录制"
            android:textColor="#66000000"
            android:textSize="@dimen/v2_status_bar_body_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@id/tv_status_bar_recording_label" />

        <CheckedTextView
            android:id="@+id/switch_status_bar_recording"
            android:layout_width="@dimen/v2_status_bar_switch_w"
            android:layout_height="@dimen/v2_status_bar_switch_h"
            android:background="@drawable/v2_status_bar_switch_bg"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/v2_status_bar_divider_gap"
        android:background="#1A000000" />

    <Button
        android:id="@+id/btn_status_bar_open"
        android:layout_width="match_parent"
        android:layout_height="@dimen/v2_status_bar_btn_h"
        android:layout_marginTop="@dimen/v2_status_bar_divider_gap"
        android:background="@drawable/v2_status_bar_button_bg"
        android:gravity="center"
        android:includeFontPadding="false"
        android:stateListAnimator="@null"
        android:textAlignment="center"
        android:text="打开主界面"
        android:textAllCaps="false"
        android:textColor="#E5000000"
        android:fontFamily="sans-serif-medium"
        android:textSize="@dimen/v2_status_bar_body_text"
        android:textStyle="bold" />
</LinearLayout>
